# Application Settings
APP_NAME=ClinTrace AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key

# Database (SQLite for MVP)
DATABASE_URL=sqlite:///./clintrace.db

# Session / Security
SESSION_COOKIE_NAME=clintrace_session
SESSION_EXPIRE_MINUTES=1440
COOKIE_SECURE=false

# File Storage (kept outside frontend public directory)
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10

# AI Provider Configuration
AI_PROVIDER=grok
AI_MODEL=grok-3-mini
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.x.ai/v1
AI_TIMEOUT_SECONDS=60

# Optional Tesseract path override on Windows
TESSERACT_CMD=
